#!/usr/bin/bash

PATH=/opt/local/gnu/bin:/opt/local/bin:/opt/local/sbin:/usr/bin:/usr/sbin

# Exit if any command fail
set -o errexit

CACHET_VERSION="master"
DESTDIR="/var/www/htdocs"

echo "* Remove unused httpd config files"
HTTPD_CONF_RM="httpd-autoindex.conf
httpd-dav.conf
httpd-default.conf
httpd-info.conf
httpd-languages.conf
httpd-manual.conf
httpd-mpm.conf
httpd-multilang-errordoc.conf
httpd-ssl.conf
httpd-userdir.conf
httpd-vhosts.conf"

for CONF_RM in ${HTTPD_CONF_RM}; do
  rm -f /opt/local/etc/httpd/${CONF_RM}
done

# https://cachethq.io/docs/v3.x/installation
echo "* Install Cachet"
mkdir -p "${DESTDIR}"
cd "${DESTDIR}"
git clone -b 3.x https://github.com/cachethq/cachet.git

echo "* Setup Cachet"
chown -R www:www /var/www/htdocs/cachet/storage
sed -i \
  -e "s|Disallow:|Disallow: /|" \
  /var/www/htdocs/cachet/public/robots.txt

(
  cd /var/www/htdocs/cachet
  yes | composer install --no-dev -o
  yes | composer update cachethq/core
  cp .env.example .env
  php artisan key:generate
  php artisan vendor:publish --tag=cachet
  # php artisan migrate
  chown -R www:www .
  # php artisan queue:work &
)
  
# * * * * * php artisan schedule:run >> /dev/null 2>&1

# Configuring image specific packages
echo "* Configuring image specific packages.";
mkdir -p /var/log/httpd/old
mkdir -p /opt/local/etc/httpd/ssl || true
chmod 0640 /opt/local/etc/httpd/ssl
ln -nfs /opt/local/etc/httpd/ssl /opt/local/etc/httpd/tls

# echo "* Enable ipfilter"
# svcadm enable svc:/network/ipfilter:default

# Clean up
echo "* Cleaning up."
rm /root/customize
mkdir -p /nonexistent

# Prepare image for provisioning
sm-prepare-image -y
